DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=api.yourdomain.tld
CORS_ALLOWED_ORIGINS=https://stockflow-sigma.vercel.app

DB_NAME=rjogani
DB_USER=postgres
DB_PASSWORD=change-me-local
DB_HOST=127.0.0.1
DB_PORT=5433

# Docker PostgreSQL settings. The host port avoids colliding with a locally
# installed PostgreSQL service that may already use 5432.
POSTGRES_DB=rjogani
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local

# For reset password - SMTP
EMAIL_HOST="smtp-host"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER="smtip-user"
EMAIL_HOST_PASSWORD="smtp-password"
DEFAULT_FROM_EMAIL="from-email"

# For web push notification
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
CELERY_BROKER_URL=

# For mobile push (FCM) — absolute path to the Firebase Admin service-account JSON
FIREBASE_CREDENTIALS=
